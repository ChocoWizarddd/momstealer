<?xml version="1.0" encoding="utf-8"?>
<!-- Theme-aware tint for the ic_lyrics_add icon (beamed notes + add badge,
     per the Lyricsss.jpg reference). All-white silhouette, single-tint:
     normal: quiet cream - pressed: gold - activated (lyrics open): gold
     disabled: muted -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" android:color="@color/nightlight_gold" />
    <item android:state_activated="true" android:color="@color/nightlight_gold" />
    <item android:state_enabled="false" android:color="@color/nightlight_muted" />
    <item android:color="@color/nightlight_cream" />
    <item android:color="@color/nightlight_cream" />
</selector>
