<?xml version="1.0" encoding="utf-8"?>
<!-- Elevated charcoal control panel used under the Now Playing controls. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Frosted base -->
    <item>
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="24dp" android:topRightRadius="24dp" />
            <solid android:color="@color/glass_panel" />
            <stroke
                android:width="1dp"
                android:color="#12121212" />
        </shape>
    </item>
    <!-- Soft gloss falling from the top edge -->
    <item>
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="24dp" android:topRightRadius="24dp" />
            <gradient
                android:angle="270"
                android:startColor="#08FFFFFF"
                android:centerColor="#03121212"
                android:endColor="#00121212" />
        </shape>
    </item>
</layer-list>
