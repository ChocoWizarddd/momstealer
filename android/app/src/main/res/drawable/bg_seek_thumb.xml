<?xml version="1.0" encoding="utf-8"?>
<!-- Fixed-size seek thumb; explicit dimensions prevent vertical inflation. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="22dp"
        android:height="22dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#6662D35B" />
            <size
                android:width="22dp"
                android:height="22dp" />
        </shape>
    </item>
    <item
        android:width="15dp"
        android:height="15dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="@color/nightlight_ivory" />
            <stroke
                android:width="1dp"
                android:color="#B862D35B" />
            <size
                android:width="15dp"
                android:height="15dp" />
        </shape>
    </item>
</layer-list>
