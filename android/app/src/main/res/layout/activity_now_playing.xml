<?xml version="1.0" encoding="utf-8"?>
<!-- Now Playing: artwork-led player with working seek, queue and transport controls. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/now_playing_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_now_playing">

    <!-- Artwork atmosphere bleeding behind everything -->
    <ImageView
        android:id="@+id/np_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.52"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <!-- Readability scrim -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_scrim_art" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top bar: minimize · title · more -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageButton
                android:id="@+id/np_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_transport_circle"
                android:contentDescription="@string/action_back"
                android:padding="9dp"
                android:src="@drawable/ic_chevron_down"
                app:tint="@color/nightlight_cream" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:letterSpacing="0.02"
                android:text="@string/now_playing_desc"
                android:textColor="@color/nightlight_ivory"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/np_share"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_transport_circle"
                android:contentDescription="@string/action_more"
                android:padding="9dp"
                android:src="@drawable/ic_more_vert"
                app:tint="@color/nightlight_cream" />
        </LinearLayout>

        <!-- Large square album artwork. -->
        <FrameLayout
            android:id="@+id/np_artwork_stage"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.nightlight.app.ui.common.VinylView
                android:id="@+id/np_disc_view"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_gravity="center"
                android:background="@android:color/transparent" />
        </FrameLayout>

        <!-- Metadata: library utility · title/artist · like.
             Kept under the id np_banner: the ambient animator and the
             track-transition enter animation target this container. -->
        <LinearLayout
            android:id="@+id/np_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingTop="4dp"
            android:paddingEnd="24dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start"
                android:orientation="vertical">

                <!-- match_parent (not wrap_content) on purpose: marquee only
                     scrolls when the TextView is narrower than its text, so the
                     two lines must fill the bounded column and clip. -->
                <TextView
                    android:id="@+id/np_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="marquee"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="start"
                    android:letterSpacing="0.01"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:singleLine="true"
                    android:textColor="@color/nightlight_ivory"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/np_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="marquee"
                    android:gravity="start"
                    android:letterSpacing="0.05"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:singleLine="true"
                    android:textColor="@color/nightlight_cream_dim"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/np_like"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_like"
                android:padding="10dp"
                android:src="@drawable/ic_favorite_border"
                app:tint="@color/nightlight_cream" />

            <ImageButton
                android:id="@+id/np_queue"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_queue"
                android:padding="10dp"
                android:src="@drawable/ic_queue_music"
                app:tint="@color/nightlight_cream" />
        </LinearLayout>

        <!-- Glass control panel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_panel"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="18dp"
            android:paddingEnd="24dp"
            android:paddingBottom="10dp">

            <!-- Waveform with tiny time labels at the far ends -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/np_position"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/nightlight_cream_dim"
                    android:textSize="10sp" />

                <com.nightlight.app.ui.common.WaveformSeekView
                    android:id="@+id/np_seek"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/np_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:textColor="@color/nightlight_cream_dim"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Transport row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/np_previous"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_previous"
                    android:padding="14dp"
                    android:src="@drawable/ic_skip_previous"
                    app:tint="@color/nightlight_cream" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/np_play_pause"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/bg_player_play_button"
                    android:contentDescription="@string/cd_play_pause"
                    android:padding="17dp"
                    android:src="@drawable/ic_play"
                    app:tint="@color/nightlight_navy_deep" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/np_next"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_next"
                    android:padding="14dp"
                    android:src="@drawable/ic_skip_next"
                    app:tint="@color/nightlight_cream" />
            </LinearLayout>

            <!-- Bottom row: shuffle · curved Lyrics tab · repeat -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/np_shuffle"
                        android:layout_width="@dimen/control_button"
                        android:layout_height="@dimen/control_button"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/action_shuffle"
                        android:padding="12dp"
                        android:src="@drawable/ic_shuffle_smart"
                        app:tint="@color/nightlight_cream_dim" />

                    <TextView
                        android:id="@+id/np_shuffle_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.14"
                        android:text="SMART"
                        android:textColor="@color/nightlight_cream_dim"
                        android:textSize="8sp" />
                </LinearLayout>

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/np_lyrics"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_lyrics_tab"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="36dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="36dp"
                    android:paddingBottom="15dp"
                    android:text="@string/lyrics_title"
                    android:textColor="@color/nightlight_ivory"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/np_repeat"
                    android:layout_width="@dimen/control_button"
                    android:layout_height="@dimen/control_button"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_repeat"
                    android:padding="12dp"
                    android:src="@drawable/ic_repeat"
                    app:tint="@color/nightlight_cream_dim" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
