<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nightlight_navy_deep"
    android:orientation="vertical">

    <TextView
        android:id="@+id/search_heading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingTop="16dp"
        android:paddingEnd="8dp"
        android:paddingBottom="2dp"
        android:text="Search"
        android:textColor="@color/nightlight_cream"
        android:textSize="22sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">
        <EditText
            android:id="@+id/search_input"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_search_bar"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="12dp"
            android:drawableTint="@color/search_field_hint"
            android:hint="What do you want to hear?"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/search_field_text"
            android:textColorHint="@color/search_field_hint"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/search_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="6dp"
            android:text="Cancel"
            android:textColor="@color/nightlight_cream"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/search_browse"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="14dp"
        android:paddingEnd="12dp"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Browse music"
            android:textColor="@color/nightlight_cream"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/search_category_pop"
                android:layout_width="0dp"
                android:layout_height="92dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_category_purple"
                android:clickable="true"
                android:focusable="true"
                android:gravity="top|start"
                android:padding="12dp"
                android:text="Pop"
                android:textColor="@color/nightlight_ivory"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/search_category_indie"
                android:layout_width="0dp"
                android:layout_height="92dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_category_olive"
                android:clickable="true"
                android:focusable="true"
                android:gravity="top|start"
                android:padding="12dp"
                android:text="Indie"
                android:textColor="@color/nightlight_ivory"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Explore by sound"
            android:textColor="@color/nightlight_cream"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/search_category_hiphop"
                android:layout_width="0dp"
                android:layout_height="92dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_category_blue"
                android:clickable="true"
                android:focusable="true"
                android:gravity="top|start"
                android:padding="12dp"
                android:text="Hip-Hop"
                android:textColor="@color/nightlight_ivory"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/search_category_rock"
                android:layout_width="0dp"
                android:layout_height="92dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_category_orange"
                android:clickable="true"
                android:focusable="true"
                android:gravity="top|start"
                android:padding="12dp"
                android:text="Rock"
                android:textColor="@color/nightlight_ivory"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/search_category_jazz"
                android:layout_width="0dp"
                android:layout_height="92dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_category_green"
                android:clickable="true"
                android:focusable="true"
                android:gravity="top|start"
                android:padding="12dp"
                android:text="Jazz"
                android:textColor="@color/nightlight_ivory"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/search_category_electronic"
                android:layout_width="0dp"
                android:layout_height="92dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_category_navy"
                android:clickable="true"
                android:focusable="true"
                android:gravity="top|start"
                android:padding="12dp"
                android:text="Electronic"
                android:textColor="@color/nightlight_ivory"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Results list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/search_results"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        android:scrollbars="none" />

    <TextView
        android:id="@+id/search_recent_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp"
        android:text="Recent searches"
        android:textColor="@color/nightlight_cream"
        android:textSize="17sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Recent searches -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/search_recent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:scrollbars="none" />

    <!-- State view (loading / empty / error / offline / rate limited) -->
    <LinearLayout
        android:id="@+id/search_state"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/search_state_progress"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:indeterminateTint="@color/nightlight_gold" />

        <ImageView
            android:id="@+id/search_state_icon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:alpha="0.7"
            android:contentDescription="@string/empty_search_hint"
            android:src="@drawable/ic_music_note"
            app:tint="@color/nightlight_star"
            android:visibility="gone" />

        <TextView
            android:id="@+id/search_state_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="@color/nightlight_cream_dim"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/search_state_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/action_retry"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
