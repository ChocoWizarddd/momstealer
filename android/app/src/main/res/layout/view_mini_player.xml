<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mini_player_root"
    android:layout_width="match_parent"
    android:layout_height="@dimen/mini_player_height"
    android:layout_marginStart="6dp"
    android:layout_marginEnd="6dp"
    android:layout_marginBottom="2dp"
    android:background="@drawable/bg_mini_player"
    android:clickable="true"
    android:focusable="true"
    android:contentDescription="@string/now_playing_desc"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="6dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="38dp"
            android:layout_height="38dp"
            app:cardCornerRadius="2dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">
            <ImageView
                android:id="@+id/mini_artwork"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_artwork_placeholder"
                android:clipToOutline="true"
                android:contentDescription="@string/artwork_desc"
                android:scaleType="centerCrop" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/mini_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/nightlight_cream"
                android:textSize="11sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/mini_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/nightlight_cream_dim"
                android:textSize="9sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/mini_like"
            android:layout_width="34dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_like"
            android:src="@drawable/ic_favorite_border"
            app:tint="@color/nightlight_cream_dim" />

        <ImageButton
            android:id="@+id/mini_play_pause"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_play_pause"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_play"
            app:tint="@color/nightlight_cream" />
    </LinearLayout>

    <View
        android:id="@+id/mini_progress_track"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_gravity="bottom"
        android:background="#555555" />
    <View
        android:id="@+id/mini_progress_fill"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:layout_gravity="bottom|start"
        android:background="@color/nightlight_gold" />
</FrameLayout>
