<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tablet_now_playing_panel"
    android:layout_width="272dp"
    android:layout_height="match_parent"
    android:background="@color/nightlight_navy"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="28dp"
    android:paddingEnd="18dp"
    android:paddingBottom="18dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Now Playing"
        android:textColor="@color/nightlight_cream"
        android:textSize="16sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/tablet_now_playing_artwork"
        android:layout_width="match_parent"
        android:layout_height="236dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_artwork_placeholder"
        android:contentDescription="@string/artwork_desc"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/tablet_now_playing_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Nothing playing"
        android:textColor="@color/nightlight_cream"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tablet_now_playing_artist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Choose a track to start listening"
        android:textColor="@color/nightlight_cream_dim"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tablet_now_playing_album"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/nightlight_cream_dim"
        android:textSize="13sp" />
</LinearLayout>
